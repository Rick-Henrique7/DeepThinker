{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep thinker",
  "version": "0.1.0",
  "identifier": "com.deepthinker.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm --prefix ../frontend run dev",
      "wait": false
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "shortDescription": "Suas notas ligadas, com uma IA que conhece o que você já pensou.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
